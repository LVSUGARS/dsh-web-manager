<Window x:Class="DshLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSH Web Launcher" Width="1080" Height="700" MinWidth="860" MinHeight="560"
        FontFamily="Microsoft YaHei UI"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <Border x:Name="Shell" Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="1" ClipToBounds="True" SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Background="{DynamicResource HeroGradient}">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Rectangle Grid.ColumnSpan="2" Grid.RowSpan="2" Fill="{DynamicResource GridBrush}" IsHitTestVisible="False" />
            <Border x:Name="SidebarBorder" Grid.Column="0" Grid.RowSpan="2" Width="220" HorizontalAlignment="Left" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Background="{DynamicResource SidebarBrush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="6,0,6,0">
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarLogoColumn" Width="Auto"/><ColumnDefinition x:Name="SidebarBrandColumn" Width="*"/><ColumnDefinition x:Name="SidebarToggleColumn" Width="Auto"/></Grid.ColumnDefinitions>
                            <Viewbox x:Name="SidebarLogo" Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left" MouseLeftButtonDown="SidebarLogo_MouseLeftButtonDown" Cursor="Hand" Margin="19,0,0,0">
                                <Path Data="{StaticResource WhaleGeometry}" Fill="{DynamicResource PrimaryTextBrush}" Stretch="Uniform" />
                            </Viewbox>
                        <StackPanel x:Name="BrandTextPanel" Grid.Column="1" VerticalAlignment="Center" Margin="11,0,6,0">
                            <TextBlock x:Name="AppTitleText" Text="DSH Web" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="AppSubtitleText" Text="Launcher" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Button x:Name="SidebarToggleButton" Grid.Column="2" Width="28" Height="30" Padding="0" ToolTip="收起侧边栏" Click="SidebarToggle_Click" Background="Transparent">
                            <Path x:Name="SidebarTogglePath" Data="M8,3 L3,8 L8,13" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </Grid>
                    <StackPanel x:Name="SidebarNavPanel" Grid.Row="1" Margin="12,14,12,0">
                        <Button x:Name="HomeNav" Style="{StaticResource SidebarNavButtonStyle}" Click="HomeNav_Click" ToolTip="启动">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M3,9 L10,3 L17,9 L17,17 L12,17 L12,12 L8,12 L8,17 L3,17 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent"/><TextBlock x:Name="HomeNavText" Grid.Column="1" Text="启动" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Grid>
                        </Button>
                    </StackPanel>
                      <StackPanel Grid.Row="2" Margin="12,0,12,20">
                          <TextBlock x:Name="NavStateLabel" Text="状态" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,7" />
                          <StackPanel x:Name="SidebarStatusPanel" Orientation="Horizontal">
                              <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#A4ADBC" VerticalAlignment="Center" Margin="0,0,8,0" />
                              <TextBlock x:Name="NavStatusText" Text="检测中" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                          </StackPanel>
                          <Border x:Name="SidebarDivider" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14" />
                          <Button x:Name="AboutNav" Style="{StaticResource SidebarNavButtonStyle}" Click="AboutNav_Click" ToolTip="关于与更新">
                              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M10,9 L10,15 M10,6 L10,6.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" Fill="Transparent"/><TextBlock x:Name="AboutNavText" Grid.Column="1" Text="关于与更新" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Grid>
                          </Button>
                          <Button x:Name="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="SettingsNav_Click" ToolTip="设置">
                              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M10,7 A3,3 0 1 0 10,13 A3,3 0 1 0 10,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent"/><TextBlock x:Name="SettingsNavText" Grid.Column="1" Text="设置" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Grid>
                          </Button>
                      </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Grid.Row="0" Background="{DynamicResource HeaderBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button x:Name="LanguageButton" Content="中文" Width="52" Height="32" Padding="0" Margin="18,0,0,0" Click="Language_Click" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" ToolTip="切换语言" />
                  </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" Content="-" Style="{StaticResource WindowControlButtonStyle}" Click="Minimize_Click" ToolTip="最小化" />
                    <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource WindowControlButtonStyle}" Click="Maximize_Click" ToolTip="最大化" />
                    <Button x:Name="CloseButton" Content="×" Style="{StaticResource WindowCloseButtonStyle}" Click="Close_Click" ToolTip="关闭" />
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="38,30,42,38">
                    <Grid>
                        <Grid x:Name="HomePage">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                                <TextBlock x:Name="HomeTitle" Text="启动台" FontSize="32" FontWeight="SemiBold" />
                                <TextBlock x:Name="HomeSubtitle" Text="管理 DSH Web 的运行状态、工作区与本地访问。" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" />
                            </StackPanel>
                            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="26" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="HeroDot" Width="11" Height="11" Fill="#A4ADBC" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock x:Name="HeroState" Text="正在检测" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock x:Name="HeroMessage" Text="正在读取 DSH 安装与服务状态…" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="21,8,0,0" />
                                        <WrapPanel Margin="21,18,0,0">
                                            <TextBlock x:Name="AddressLabel" Text="地址  " FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock x:Name="UrlText" Text="http://127.0.0.1:3080" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="    PID  " FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="18,0,0,0" />
                                            <TextBlock x:Name="PidText" Text="—" FontSize="12" FontWeight="SemiBold" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PrimaryAction" Content="启动 DSH Web" Click="PrimaryAction_Click" Background="{DynamicResource PrimaryActionGradient}" Foreground="White" FontWeight="SemiBold" Padding="22,13" />
                                        <Button x:Name="SecondaryAction" Content="停止" Click="SecondaryAction_Click" Background="{DynamicResource SurfaceMutedBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="10,0,0,0" Padding="18,13" Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,10,0" MouseLeftButtonDown="ConfigCard_MouseLeftButtonDown" Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock x:Name="ConfigTitle" Text="运行配置" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock x:Name="WorkspaceLabel" Text="工作区" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,18,0,4" />
                                        <TextBlock x:Name="WorkspaceText" Text="尚未选择" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="PortLabel" Text="监听端口" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,15,0,4" />
                                        <TextBlock x:Name="PortText" Text="3080" FontSize="13" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="10,0,0,0" MouseLeftButtonDown="RuntimeCard_MouseLeftButtonDown" Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock x:Name="RuntimeTitle" Text="运行环境" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="DSH CLI" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,18,0,4" />
                                        <TextBlock x:Name="DshVersionText" Text="未检测到" FontSize="13" />
                                        <TextBlock x:Name="InstallModeLabel" Text="安装方式" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,15,0,4" />
                                        <TextBlock x:Name="InstallModeText" Text="—" FontSize="13" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                        <Grid x:Name="SettingsPage" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="SettingsTitle" Text="设置" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock x:Name="SettingsSubtitle" Text="调整 Launcher 和 DSH Web 的默认行为。" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,7,0,24" />
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
                                    <StackPanel>
                                        <TextBlock x:Name="DshWebSettingsTitle" Text="DSH Web" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="WorkspacePathLabel" Text="工作区路径" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,18,0,6" />
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WorkspaceInput" Grid.Column="0" Padding="12,9" BorderBrush="{DynamicResource BorderBrush}" /><Button x:Name="BrowseWorkspaceButton" Grid.Column="1" Content="选择文件夹" Click="BrowseWorkspace_Click" Background="{DynamicResource SurfaceMutedBrush}" Margin="10,0,0,0" /></Grid>
                                        <TextBlock x:Name="PortInputLabel" Text="监听端口" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,18,0,6" />
                                        <TextBox x:Name="PortInput" Width="110" HorizontalAlignment="Left" Padding="12,9" BorderBrush="{DynamicResource BorderBrush}" />
                                        <CheckBox x:Name="AutoOpenCheck" Content="DSH Web 启动成功后自动打开浏览器" Margin="0,22,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                        <CheckBox x:Name="AutostartCheck" Content="登录 Windows 后自动启动 DSH Web" Margin="0,12,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="AppearanceTitle" Text="外观与关闭行为" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ThemeLabel" Text="主题" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,19,0,7" />
                                        <Border Background="{DynamicResource SurfaceMutedBrush}" BorderThickness="0" CornerRadius="9" Padding="3">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button x:Name="ThemeSystemButton" Grid.Column="0" Content="跟随系统" Tag="system" Style="{StaticResource SegmentButtonStyle}" Click="ThemeOption_Click" />
                                                <Button x:Name="ThemeLightButton" Grid.Column="1" Content="浅色" Tag="light" Style="{StaticResource SegmentButtonStyle}" Click="ThemeOption_Click" />
                                                <Button x:Name="ThemeDarkButton" Grid.Column="2" Content="深色" Tag="dark" Style="{StaticResource SegmentButtonStyle}" Click="ThemeOption_Click" />
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="CloseBehaviorLabel" Text="关闭窗口" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,18,0,7" />
                                        <Border Background="{DynamicResource SurfaceMutedBrush}" BorderThickness="0" CornerRadius="9" Padding="3">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button x:Name="CloseAskButton" Grid.Column="0" Content="每次询问" Tag="ask" Style="{StaticResource SegmentButtonStyle}" Click="CloseBehaviorOption_Click" />
                                                <Button x:Name="CloseTrayButton" Grid.Column="1" Content="最小化到托盘" Tag="tray" Style="{StaticResource SegmentButtonStyle}" Click="CloseBehaviorOption_Click" />
                                                <Button x:Name="CloseExitButton" Grid.Column="2" Content="直接退出 Launcher" Tag="exit" Style="{StaticResource SegmentButtonStyle}" Click="CloseBehaviorOption_Click" />
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="CloseBehaviorHelp" Text="选择“每次询问”时，关闭窗口会让你决定最小化到托盘或直接退出。" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,13,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="AboutPage" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="AboutTitle" Text="关于与更新" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock x:Name="AboutSubtitle" Text="查看版本信息和 Launcher 更新状态。" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,7,0,24" />
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
                                    <StackPanel>
                                        <TextBlock Text="DSH Web Launcher" FontSize="19" FontWeight="SemiBold" />
                                        <TextBlock x:Name="LauncherVersionText" Text="Launcher 版本 2.0.0" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,7,0,0" />
                                        <Grid Margin="0,28,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"><TextBlock Text="DSH CLI" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock x:Name="AboutDshVersion" Text="未检测到" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                            <StackPanel Grid.Column="1"><TextBlock Text="Node.js" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock x:Name="AboutNodeVersion" Text="检测中" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock x:Name="CurrentStatusLabel" Text="当前状态" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock x:Name="AboutStatus" Text="检测中" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,16,0,0">
                                      <StackPanel>
                                          <TextBlock x:Name="DshUpdateTitle" Text="DSH Web 更新" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="DshUpdateText" Text="尚未检查 DSH 更新。" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,16" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="DshCheckUpdateButton" Content="检查更新" Click="DshCheckUpdate_Click" Background="{DynamicResource AccentBrush}" Foreground="White"/>
                                                <Button x:Name="DshUpdateButton" Content="更新 DSH" Click="DshUpdate_Click" Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0" Visibility="Collapsed"/>
                                                <Button x:Name="DshOpenOfficialButton" Content="打开官网" Click="DshOpenOfficial_Click" Background="{DynamicResource SurfaceMutedBrush}" Margin="10,0,0,0"/>
                                                <Button x:Name="DshOpenGitHubButton" Content="GitHub" Click="DshOpenGitHub_Click" Background="{DynamicResource SurfaceMutedBrush}" Margin="10,0,0,0"/>
                                            </StackPanel>
                                      </StackPanel>
                                  </Border>
                                  
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,16,0,0">
                                    <StackPanel><TextBlock x:Name="LauncherUpdateTitle" Text="Launcher 更新" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="UpdateText" Text="尚未检查更新" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,16" TextWrapping="Wrap"/><ProgressBar x:Name="UpdateProgress" Height="6" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,0,0,16"/><StackPanel Orientation="Horizontal"><Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" Background="{DynamicResource AccentBrush}" Foreground="White"/><Button x:Name="InstallUpdateButton" Content="下载并安装" Click="InstallUpdate_Click" Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0" Visibility="Collapsed"/><Button x:Name="OpenReleaseButton" Content="打开 GitHub Releases" Click="OpenRelease_Click" Background="{DynamicResource SurfaceMutedBrush}" Margin="10,0,0,0"/></StackPanel></StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
      <Grid x:Name="SplashOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" Panel.ZIndex="100" Background="{DynamicResource WindowBackground}" PreviewMouseLeftButtonDown="SplashOverlay_PreviewMouseLeftButtonDown">
          <Rectangle Fill="{DynamicResource GridBrush}" IsHitTestVisible="False" />
            <Rectangle Fill="{DynamicResource HeroGradient}" IsHitTestVisible="False" />
            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                <Grid Width="1080" Height="700">
                    <Ellipse Width="260" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.34" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#5C8FD6" Offset="0" />
                                <GradientStop Color="#122A4A" Offset="0.55" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Canvas x:Name="ParticleCanvas" Width="700" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,16">
                        <Viewbox Width="100" Height="100" HorizontalAlignment="Center" Opacity="0">
                            <Path Data="{StaticResource WhaleGeometry}" Fill="{DynamicResource PrimaryTextBrush}" Stretch="Uniform" />
                        </Viewbox>
                        <TextBlock Text="DSH Web Launcher" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                        <TextBlock Text="DEEPSEEK HARNESS  ·  LOCAL CONSOLE" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,0" />
                        <Border Height="1" Width="72" Background="#78A8FF" Opacity="0.72" HorizontalAlignment="Center" Margin="0,22,0,20" />
                        <TextBlock Text="探索未至之境" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Viewbox>
          <StackPanel x:Name="SplashWindowControls" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,18,0">
              <Button Content="-" Width="46" Height="32" Padding="0" Style="{StaticResource WindowControlButtonStyle}" Click="SplashMinimize_Click" ToolTip="最小化" />
              <Button Content="□" Width="46" Height="32" Padding="0" Style="{StaticResource WindowControlButtonStyle}" Click="SplashMaximize_Click" ToolTip="最大化" />
              <Button Content="×" Width="46" Height="32" Padding="0" Style="{StaticResource WindowCloseButtonStyle}" Click="SplashClose_Click" ToolTip="关闭" />
          </StackPanel>
            <TextBlock x:Name="VersionText" Text="v2.0.1  ·  LVSUGARS" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,18" Opacity="0.9" />
      </Grid>
        </Grid>
    </Border>
</Window>
